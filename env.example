# Copy to .env (or export in your shell) for the live gateway drill (phase 2).
# The test suite does NOT need any of this: it runs against the built-in fake broker.

# Host where IB Gateway / TWS is listening (paper account only)
IB_HOST=127.0.0.1

# 4002 = IB Gateway paper, 7497 = TWS paper
IB_PORT=4002

# Any free client id
IB_CLIENT_ID=17

# Your paper account id (starts with DU). Never use a live account.
IB_ACCOUNT=DU1234567
